#!/bin/sh
# Set this machine up, once: ask what it should do about networking and which
# keyboard it has, then grow the root filesystem into the storage device and
# add swap.
#
# This runs in two passes with a reboot between them, and that is a constraint
# rather than a choice: the kernel will not re-read a partition table while one
# of that disk's partitions is mounted, and / always is. So pass 1 rewrites the
# table and reboots, and pass 2 - which now sees the larger partition - grows
# the filesystem onto it and brings up swap. Raspberry Pi OS splits its own
# resize the same way for the same reason.
#
# The partition table is written byte by byte instead of through fdisk: the
# layout wanted is exact and already known (partition 1 and the start of
# partition 2 never move), and 16 bytes per entry is less machinery than
# driving an interactive tool from a script.

STATE=/var/lib/sepia
DONE=$STATE/firstboot-done
PENDING=$STATE/resize-pending
SETUP=$STATE/setup-done

KEYMAP_DIR=/usr/share/keymaps
NETWORK=/usr/sbin/sepia-network
KEYMAP=/usr/bin/sepia-keymap

# How long to wait for an answer. The first question is the one that finds out
# whether anybody is there: if it goes unanswered the rest are not asked at all,
# which bounds a screen nobody is watching to one wait rather than several.
FIRST_WAIT=60
NEXT_WAIT=120

[ -f "$DONE" ] && [ -f "$SETUP" ] && exit 0
mkdir -p "$STATE"

say() { echo "sepia-firstboot: $*"; }
give_up() { say "$*"; say "leaving the storage layout alone"; touch "$DONE"; exit 0; }

# --- asking, where there is somebody to ask ---------------------------------
#
# These questions need a keyboard, and the only console this can be sure has
# one is a virtual terminal. /proc/consoles flags the console /dev/console
# resolves to; if that is a UART then there may be a person at the far end of
# it or there may be nothing at all, and a read that blocks on a headless board
# is a board that never finishes booting. So a VT gets asked, and anything else
# keeps the defaults - which are the ones the image ships with anyway, and
# which sepia-network and sepia-keymap can change at any time afterwards.
#
# When there is nothing to ask, the marker is deliberately left unwritten until
# the storage work has finished. That is what makes the QEMU launcher work:
# tools/qemu.sh runs first boot headlessly, on serial, before it opens a
# window, so the questions would otherwise be swallowed by a boot nobody was
# watching. Once the resizing is done the marker is written anyway, so a board
# that is always headless is asked twice and then left alone.

console_is_vt() {
	[ -c /dev/console ] || return 1
	[ -r /proc/consoles ] || return 1
	# Field 3 is the flag group, "(EC" or "(E"; C marks the console that
	# /dev/console resolves to. Same field sepia-gettys reads.
	awk '$3 ~ /C/ { print $1 }' /proc/consoles | grep -qE '^tty[0-9]+$'
}

# The questions are written to the console on fd 3 rather than to stdout, and
# that is not tidiness. Printed to the stdout init hands a sysinit script, none
# of it appears on screen during boot - the same echoes are perfectly visible
# when the script is run from a shell afterwards. Writing to the console that
# is being read from is what a getty does, and it puts the prompt where the
# answer is coming from.
out()  { printf '%s\n' "$*" >&3; }
outn() { printf '%s' "$*" >&3; }

# Reads one line from the console, or fails if nothing arrives in $1 seconds.
# $2 = silent, for the passphrase.
ask() {
	line=
	if [ "${2:-}" = silent ]; then
		read -t "$1" -s -r line <&3 || return 1
		out ""
	else
		read -t "$1" -r line <&3 || { out ""; return 1; }
	fi
	printf '%s\n' "$line"
}

ask_network() {
	out ""
	out "  Network"
	out "    1) Ethernet (DHCP)"
	out "    2) Wifi (DHCP)"
	out "    3) Both"
	out "    4) None"
	outn '  Choose 1-4 [1]: '
	answer=$(ask "$FIRST_WAIT") || return 1

	ssid= ; psk= ; country=
	case "$answer" in
		2) net=wifi ;;
		3) net=both ;;
		4) net=none ;;
		*) net=ethernet ;;
	esac

	if [ "$net" = wifi ] || [ "$net" = both ]; then
		outn '  Wifi network name: '
		ssid=$(ask "$NEXT_WAIT") || ssid=
		if [ -n "$ssid" ]; then
			outn '  Passphrase (empty for an open network): '
			psk=$(ask "$NEXT_WAIT" silent) || psk=
			outn '  Country code, two letters (empty to skip): '
			country=$(ask "$NEXT_WAIT") || country=
		fi
	fi

	# -n throughout: this pass reboots, so applying any of it now would be
	# work thrown away. rcS brings it up on the boot after this one.
	case "$net" in
		ethernet) $NETWORK -n ethernet dhcp >/dev/null ;;
		none)     $NETWORK -n ethernet off >/dev/null; $NETWORK -n wifi off >/dev/null ;;
		wifi)     $NETWORK -n ethernet off >/dev/null ;;
		both)     $NETWORK -n ethernet dhcp >/dev/null ;;
	esac
	case "$net" in
		wifi|both)
			if [ -n "$ssid" ]; then
				$NETWORK -n wifi "$ssid" "$psk" $country >/dev/null
			else
				say "no network name given, so wifi stays off"
				$NETWORK -n wifi off >/dev/null
			fi
			;;
	esac
	say "network: $net"
	return 0
}

ask_keymap() {
	# Read from the directory rather than from `sepia-keymap list`: that is
	# where the tool itself looks, and it cannot be misparsed the way its
	# human-readable output could be.
	maps=$(for f in "$KEYMAP_DIR"/*.kmap; do
		[ -e "$f" ] || continue
		f=${f##*/}; echo "${f%.kmap}"
	done | sort)
	[ -n "$maps" ] || { say "no keymaps installed to choose from"; return 0; }
	current=$(cat /etc/keymap 2>/dev/null)

	out ""
	out "  Keyboard layout"
	i=0
	for m in $maps; do
		i=$((i + 1))
		out "$(printf '    %2d) %s' "$i" "$m")"
	done
	outn "$(printf '  Choose 1-%d [keep %s]: ' "$i" "${current:-english_us}")"
	answer=$(ask "$NEXT_WAIT") || answer=

	case "$answer" in
		''|*[!0-9]*) say "keyboard: unchanged"; return 0 ;;
	esac
	if [ "$answer" -lt 1 ] || [ "$answer" -gt "$i" ]; then
		say "keyboard: $answer is not one of 1-$i, leaving it unchanged"
		return 0
	fi
	name=$(printf '%s\n' $maps | sed -n "${answer}p")
	if $KEYMAP set-system "$name" >/dev/null 2>&1; then
		say "keyboard: $name, now and on every boot"
	else
		# The layout is still recorded; only loading it needs a console.
		echo "$name" > /etc/keymap 2>/dev/null
		say "keyboard: $name recorded, but this console has no keymap to load it into"
	fi
	return 0
}

restore_printk() {
	[ -n "${printk_was:-}" ] && dmesg -n "$printk_was" 2>/dev/null
	return 0
}

setup() {
	if ! console_is_vt; then
		say "no keyboard console to ask on; keeping the defaults"
		say "sepia-network and sepia-keymap change them whenever you like"
		[ -f "$DONE" ] && touch "$SETUP"
		return 0
	fi
	# A failed redirect on exec ends a non-interactive shell outright, so the
	# open is tried in a subshell first.
	( : <> /dev/console ) 2>/dev/null || { say "cannot open /dev/console; keeping the defaults"; return 0; }
	exec 3<> /dev/console

	# Kernel messages arriving in the middle of a question scribble over it -
	# the same problem rcS solves at the end of the boot with dmesg -n 3, and
	# here it lands squarely on the prompt. Quietened to emergencies only for
	# as long as the questions are up, and put back exactly as it was: nothing
	# is lost, dmesg still holds all of it.
	printk_was=$(cut -f1 /proc/sys/kernel/printk 2>/dev/null)
	dmesg -n 1 2>/dev/null

	out ""
	out "SepiaOS first boot. Two questions, then it carries on by itself."
	if ! ask_network; then
		say "no answer; keeping the defaults - ethernet on DHCP, keyboard unchanged"
		touch "$SETUP"
		restore_printk
		exec 3>&-
		return 0
	fi
	ask_keymap
	out ""

	touch "$SETUP"
	restore_printk
	exec 3>&-
	return 0
}

[ -f "$SETUP" ] || setup

[ -f "$DONE" ] && exit 0

# --- which device did we boot from -----------------------------------------

rootdev=
for arg in $(cat /proc/cmdline); do
	case "$arg" in root=*) rootdev=${arg#root=} ;; esac
done
case "$rootdev" in
	PARTUUID=*|UUID=*|LABEL=*) rootdev=$(findfs "$rootdev" 2>/dev/null) ;;
esac
[ -n "$rootdev" ] || give_up "no root= on the kernel command line"

part=${rootdev#/dev/}
[ -b "/dev/$part" ] || give_up "/dev/$part is not a block device"

# The partition's sysfs directory lives inside the disk's, so the parent
# directory names the disk - no guessing about whether the suffix is 'p2' or
# '2', which differs between mmcblk and sd devices.
disk=$(readlink -f "/sys/class/block/$part/..") || give_up "cannot resolve $part"
disk=${disk##*/}
[ -f "/sys/block/$disk/size" ] || give_up "no /sys/block/$disk"

# The suffix is whatever the partition name has beyond the disk name, so
# partition 3 is built the same way round: mmcblk0 + p3, sda + 3.
suffix=${part#$disk}
case "$suffix" in
	p2) sep=p ;;
	2)  sep= ;;
	*)  give_up "root is $part, not partition 2 of $disk - this is not a SepiaOS layout" ;;
esac
swappart=/dev/$disk${sep}3

disk_sectors=$(cat "/sys/block/$disk/size")
part_start=$(cat "/sys/block/$disk/$part/start")
part_sectors=$(cat "/sys/block/$disk/$part/size")

# --- pass 2: the table is already right, grow onto it -----------------------

if [ -f "$PENDING" ]; then
	say "growing the root filesystem to $((part_sectors / 2048)) MiB"
	if resize2fs "/dev/$part"; then
		say "root filesystem resized"
	else
		say "resize2fs failed - the filesystem is unchanged and still usable"
	fi

	if [ -b "$swappart" ]; then
		say "making swap on $swappart"
		if mkswap "$swappart" >/dev/null; then
			grep -q "^$swappart " /etc/fstab 2>/dev/null \
				|| echo "$swappart	none	swap	sw	0	0" >> /etc/fstab
			swapon "$swappart" && say "swap active"
		else
			say "mkswap failed - continuing without swap"
		fi
	else
		say "$swappart is missing - continuing without swap"
	fi

	rm -f "$PENDING"
	touch "$DONE"
	sync
	exit 0
fi

# --- pass 1: work out the new layout and write it ---------------------------

# Thresholds in GB as storage is sold (10^9), swap in GiB as memory is
# measured. README: under 64 GB gives 1 GiB, under 128 GB gives 2 GiB, above
# that 4 GiB.
disk_bytes=$((disk_sectors * 512))
if   [ "$disk_bytes" -lt 64000000000 ];  then swap_mib=1024
elif [ "$disk_bytes" -lt 128000000000 ]; then swap_mib=2048
else                                          swap_mib=4096
fi
swap_sectors=$((swap_mib * 2048))

# Swap starts on a 4 MiB boundary: that is the erase block size cards are
# optimised for, and it is the alignment the boot partition already uses.
align=8192
swap_start=$(( (disk_sectors - swap_sectors) / align * align ))

# The sizes above come straight from the README, and on a small card they ask
# for a swap partition bigger than the card. Growing the filesystem is the more
# useful half of this, so when swap will not fit without eating the space the
# rootfs was going to gain, the whole device goes to the rootfs and swap is
# skipped. Reported, not silent - "where is my swap" should have an answer in
# the boot log.
if [ $((swap_start - part_start)) -lt $((part_sectors + align)) ]; then
	say "a $((swap_sectors / 2048)) MiB swap partition will not fit on a $((disk_bytes / 1048576)) MiB device"
	say "using the whole device for the root filesystem instead"
	swap_sectors=0
	swap_start=0
	new_sectors=$((disk_sectors - part_start))
else
	swap_sectors=$((disk_sectors - swap_start))
	new_sectors=$((swap_start - part_start))
fi

if [ "$new_sectors" -le "$part_sectors" ]; then
	give_up "$disk holds $((disk_bytes / 1048576)) MiB, which leaves nothing to grow into"
fi

say "$disk is $((disk_bytes / 1000000000)) GB ($((disk_bytes / 1048576)) MiB)"
if [ "$swap_sectors" -gt 0 ]; then
	say "root partition $((part_sectors / 2048)) MiB -> $((new_sectors / 2048)) MiB, swap $((swap_sectors / 2048)) MiB"
else
	say "root partition $((part_sectors / 2048)) MiB -> $((new_sectors / 2048)) MiB, no swap"
fi

# One MBR entry: status, CHS first, type, CHS last, LBA start, sector count.
# The CHS fields are set to the 0xFE/0xFF/0xFF "too big to express" value that
# every tool writes for partitions beyond 8 GB; Linux ignores them entirely and
# reads the LBA fields.
byte() { printf '\\0%03o' "$1"; }
le32() {
	byte $(( $1        & 255 )); byte $(( ($1 >> 8)  & 255 ))
	byte $(( ($1 >> 16) & 255 )); byte $(( ($1 >> 24) & 255 ))
}
entry() { # type start sectors
	byte 0; byte 254; byte 255; byte 255
	byte "$1"; byte 254; byte 255; byte 255
	le32 "$2"; le32 "$3"
}

# The whole sector is read, patched and written back in one go. Writing 16
# bytes straight at the block device would work, but a single 512-byte write is
# the one that cannot leave a half-updated table behind if the power goes.
mbr=/run/sepia-mbr
dd if="/dev/$disk" of="$mbr" bs=512 count=1 2>/dev/null || give_up "cannot read the MBR of $disk"
printf '%b' "$(entry 131 "$part_start" "$new_sectors")" \
	| dd of="$mbr" bs=1 seek=462 count=16 conv=notrunc 2>/dev/null
if [ "$swap_sectors" -gt 0 ]; then
	printf '%b' "$(entry 130 "$swap_start" "$swap_sectors")" \
		| dd of="$mbr" bs=1 seek=478 count=16 conv=notrunc 2>/dev/null
fi
dd if="$mbr" of="/dev/$disk" bs=512 count=1 2>/dev/null || give_up "cannot write the MBR of $disk"
rm -f "$mbr"
sync

touch "$PENDING"
sync

say "partition table rewritten; rebooting to pick it up"
sleep 1
mount -o remount,ro / 2>/dev/null
sync
reboot -f
