#!/bin/sh
# One login prompt per console the kernel actually registered.
#
# The kernel command line the boot partition ships names two consoles
# (console=serial0,115200 console=tty1) and only the last of them becomes
# /dev/console. A single getty on /dev/console therefore leaves a headless
# board with a serial cable showing the boot messages and then nothing at all,
# while a getty per board-specific device name needs a table of which tty each
# of the six boards uses. /proc/consoles answers both: it lists every console
# the kernel has, and flags which one /dev/console resolves to.
#
# The one /dev/console points at gets its getty on "console" rather than on its
# own name, and that is not cosmetic. Under QEMU the PL011 console is called
# ttyAMA1, has no /sys/class/tty entry, and opening /dev/ttyAMA1 - even after
# creating the node from the major:minor the kernel itself reports - fails with
# ENXIO, while /dev/console opens and works. Any console the kernel is really
# using can be reached through /dev/console; its own device node is the thing
# that may not exist.
#
# The others are reached by name, and only if sysfs has an entry for them,
# because that is what distinguishes a tty that can be opened from one that
# cannot without blocking on carrier detect to find out.
#
# The lines are appended to /etc/inittab and init is signalled to re-read it:
# busybox init reloads on SIGHUP and starts the new respawn entries. Everything
# below the marker is rewritten each boot, so this converges instead of growing.

INITTAB=/etc/inittab
MARKER='# --- generated by sepia-gettys'
GETTY='respawn:/sbin/getty -L'

[ -f "$INITTAB" ] || exit 0
grep -q "^$MARKER" "$INITTAB" || exit 0
[ -r /proc/consoles ] || { echo "sepia-gettys: /proc is not mounted"; exit 0; }

new=/run/sepia-inittab
sed "/^$MARKER/q" "$INITTAB" > "$new" || exit 0

# Field 3 of a /proc/consoles line is the flag group, "(EC" or "(E"; C marks
# the console /dev/console resolves to. The last field is its major:minor.
# This goes through a file because a pipeline would put the loop in a subshell
# and lose everything it learned.
awk '{print $1, ($3 ~ /C/ ? "C" : "-"), $NF}' /proc/consoles > /run/sepia-consoles

found=
vts=
while read -r name flag dev; do
	if [ "$flag" = C ]; then
		tty=console
	else
		# tty0 is "whichever VT is in the foreground", not something to put a
		# getty on; tty1 is the one that VT starts out as.
		[ "$name" = tty0 ] && name=tty1
		tty=$name
		if [ ! -e "/sys/class/tty/$tty/dev" ]; then
			echo "sepia-gettys: $tty is a console but has no tty device; skipping it"
			continue
		fi
		if [ ! -c "/dev/$tty" ]; then
			maj=${dev%%:*}
			min=${dev##*:}
			case "$maj:$min" in
				*[!0-9:]*|:*|*:) continue ;;
			esac
			mknod "/dev/$tty" c "$maj" "$min" 2>/dev/null \
				|| { echo "sepia-gettys: cannot create /dev/$tty ($dev)"; continue; }
		fi
	fi

	grep -q "^$tty::" "$new" && continue
	echo "$tty::$GETTY $tty 0 vt100" >> "$new"
	found="$found $tty"
	# Only the VTs are worth clearing below, and tty[0-9] is what tells one
	# apart from ttyAMA1 or ttyS0. A serial terminal has neither the logo nor
	# the rows it costs, and clearing one would only throw away the boot log
	# somebody is very likely reading over the wire.
	case "$name" in
		tty[0-9]*) vts="$vts $tty" ;;
	esac
done < /run/sepia-consoles
rm -f /run/sepia-consoles

if [ -z "$found" ]; then
	echo "sepia-gettys: no usable console - there will be no login prompt"
	rm -f "$new"
	exit 0
fi

if cmp -s "$new" "$INITTAB"; then
	# Already what it should be, which is every boot after the one that first
	# wrote it: init read these lines at startup and will start the gettys on
	# its own once rcS returns, so there is nothing to signal. Not an early
	# exit, though - the console below still has to be cleared, and this is the
	# path that nearly always runs.
	rm -f "$new"
	reload=
else
	# cat, not mv: /run is a different filesystem, and rewriting in place keeps
	# the inode rather than replacing the file init was told to re-read.
	cat "$new" > "$INITTAB"
	rm -f "$new"
	echo "sepia-gettys: login prompt on$found"
	reload=1
fi

# Clear the framebuffer consoles, last thing before any login prompt can reach
# them.
#
# This is not cosmetic. The kernel draws its boot logo - one raspberry per CPU -
# and fbcon then starts the console's scrolling region *below* it, so those rows
# are gone for the life of that console and every line of output scrolls in the
# space that is left. ESC c is the VT's full reset, and reset_terminal() puts
# the scrolling region back to the top of the screen, which is the only thing
# short of a reboot that gives the rows back. `clear` does not: it blanks inside
# the region without moving it, so the logo and the loss both survive it.
#
# Before the kill below rather than after, because init starts the gettys the
# moment it is signalled; resetting afterwards would wipe a login prompt that
# had already been printed and leave an apparently blank screen until a key was
# pressed.
for vt in $vts; do
	printf '\033c' > "/dev/$vt" 2>/dev/null
done

if [ -n "$reload" ]; then
	kill -HUP 1
fi
