#!/bin/sh
# Console keyboard layout: list what there is, and choose one.
#
# A keymap belongs to the kernel's virtual terminals, not to a user and not to
# a shell - there is one keymap per VT, and loading a new one changes it for
# whoever is sitting there. "For this user" therefore means: load it now, and
# load it again whenever this user logs in. It does not mean two users get
# different layouts at the same time, because the kernel has no such thing.
# set-system is the one that survives a reboot for everybody.
#
# None of this reaches a serial console. The keymap is applied by the kernel's
# VT layer to keys arriving from a real keyboard; over a serial line the
# terminal at the far end has already decided what the bytes mean and there is
# nothing here to translate. On a board with no screen these commands say they
# cannot find a console rather than pretending to have worked.

set -u

KEYMAP_DIR=/usr/share/keymaps
SYSTEM_FILE=/etc/keymap
USER_FILE=${HOME:-/root}/.keymap

self=${0##*/}

usage() {
	cat <<USAGE
usage: $self <command> [layout]

  list                 show the layouts that are installed, a page at a time
  show                 show which layout is configured, and where from
  set <layout>         use it now, and again every time you log in
  set-system <layout>  use it now, and for everyone on every boot
  apply                load the configured layout (used at boot and login)

The layouts live in $KEYMAP_DIR. A keymap applies to the screen and
keyboard attached to the board; a serial console has no keymap of its own.
USAGE
}

die() {
	echo "$self: $*" >&2
	exit 1
}

# The name has to be one plain layout name, not a path: it is turned straight
# into a filename below.
check_name() {
	[ -n "${1:-}" ] || die "which layout? try '$self list'"
	case "$1" in
		*/*|.*) die "'$1' is not a layout name" ;;
	esac
	[ -f "$KEYMAP_DIR/$1.kmap" ] \
		|| die "no layout called '$1' - try '$self list'"
}

layouts() {
	[ -d "$KEYMAP_DIR" ] || return 0
	for f in "$KEYMAP_DIR"/*.kmap; do
		[ -e "$f" ] || continue
		f=${f##*/}
		echo "${f%.kmap}"
	done
}

configured() {
	if [ -r "$USER_FILE" ]; then
		read -r name < "$USER_FILE" && [ -n "$name" ] && { echo "$name"; return 0; }
	fi
	if [ -r "$SYSTEM_FILE" ]; then
		read -r name < "$SYSTEM_FILE" && [ -n "$name" ] && { echo "$name"; return 0; }
	fi
	return 1
}

# quiet=1 is for the boot and login callers: a board with no screen has no VT
# to load a keymap into, and that is not worth complaining about twice per
# boot. Asked for directly, the same failure is worth reporting.
load() {
	name=$1
	quiet=${2:-0}
	if loadkmap < "$KEYMAP_DIR/$name.kmap" 2>/dev/null; then
		return 0
	fi
	[ "$quiet" = 1 ] && return 1
	if [ "$(id -u)" != 0 ]; then
		die "only root can change the console keymap"
	fi
	die "could not load '$name' - no console keyboard here? (a serial console has no keymap)"
}

cmd=${1:-}
[ $# -gt 0 ] && shift

case "$cmd" in
	list)
		current=$(configured || true)
		all=$(layouts)
		[ -n "$all" ] || die "no layouts installed in $KEYMAP_DIR"
		total=$(printf '%s\n' "$all" | wc -l | tr -d ' ')

		# Paged, because there are well over a hundred of these and a plain
		# list scrolls all but the last screen of them away on a VT that
		# cannot be scrolled back.
		#
		# Only when there is somebody to page for, though. A redirected or
		# piped list is data rather than a display - `sepia-keymap list | grep
		# de` has to keep working, and so does a `wc -l` of it - so the pager
		# is skipped entirely unless stdout is a terminal. The prompt is read
		# from /dev/tty for the same reason: stdin may be something else.
		# The terminal is opened once, on its own descriptor, and held for
		# the whole listing rather than reopened at every prompt. Both work -
		# measured, through a pty, paging the full list either way - so this is
		# one open instead of one per page and nothing more than that.
		page=0
		if [ -t 1 ] && exec 4</dev/tty 2>/dev/null; then
			rows=$(stty size 2>/dev/null | cut -d' ' -f1)
			case "$rows" in
				''|*[!0-9]*) rows=24 ;;
			esac
			[ "$rows" -gt 6 ] || rows=24
			page=$((rows - 3))
		fi

		shown=0
		stopped=0
		for name in $all; do
			mark=" "
			[ "$name" = "$current" ] && mark="*"
			echo "$mark $name"
			shown=$((shown + 1))
			if [ "$page" -gt 0 ] && [ "$shown" -lt "$total" ] \
			   && [ $((shown % page)) -eq 0 ]; then
				printf -- '-- %d of %d -- Enter for more, q to stop: ' \
					"$shown" "$total"
				if ! read -r reply <&4; then
					echo
					stopped=1
					break
				fi
				case "$reply" in
					[qQ]*) stopped=1; break ;;
				esac
			fi
		done

		[ "$page" -gt 0 ] && exec 4<&-

		if [ "$stopped" = 0 ] && [ -n "$current" ]; then
			echo
			echo "* is the one in use"
		fi
		;;

	show)
		if [ -r "$USER_FILE" ]; then
			echo "user   $(cat "$USER_FILE")	($USER_FILE)"
		else
			echo "user   -"
		fi
		if [ -r "$SYSTEM_FILE" ]; then
			echo "system $(cat "$SYSTEM_FILE")	($SYSTEM_FILE)"
		else
			echo "system -"
		fi
		;;

	set)
		check_name "${1:-}"
		load "$1"
		echo "$1" > "$USER_FILE" || die "could not write $USER_FILE"
		echo "$self: '$1' is in use now, and on every login"
		;;

	set-system)
		[ "$(id -u)" = 0 ] || die "only root can set the system layout"
		check_name "${1:-}"
		load "$1"
		echo "$1" > "$SYSTEM_FILE" || die "could not write $SYSTEM_FILE"
		# A user setting would otherwise keep overriding what was just asked
		# for system-wide, which reads as the command having done nothing.
		if [ -r "$USER_FILE" ] && [ "$(cat "$USER_FILE")" != "$1" ]; then
			echo "$self: note - $USER_FILE still says '$(cat "$USER_FILE")', and that wins here"
		fi
		echo "$self: '$1' is in use now, and on every boot"
		;;

	apply)
		name=$(configured) || exit 0
		[ -f "$KEYMAP_DIR/$name.kmap" ] || exit 0
		load "$name" 1 || exit 0
		;;

	""|-h|--help|help)
		usage
		;;

	*)
		echo "$self: no such command '$cmd'" >&2
		usage >&2
		exit 1
		;;
esac
